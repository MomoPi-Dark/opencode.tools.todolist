{
  "name": "opencode-sidebar-modern-todolist",
  "version": "1.1.0",
  "description": "OpenCode TUI sidebar plugin for hierarchical todo list tracking.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build-tsx.mjs",
    "test": "bun test/manage-todo.test.ts && bun test/build-tui.test.mjs",
    "typecheck": "bun x tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opentui",
    "tui",
    "todolist",
    "todos"
  ],
  "author": "Gamflaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MomoPi-Dark/opencode-todolist"
  },
  "dependencies": {
    "@opencode/client": "^2.0.18",
    "@opencode/plugin": "^2.0.18",
    "@opencode/theme": "^2.0.21",
    "@opentui/core": "^0.5.17",
    "@opentui/solid": "^0.5.17",
    "@resvg/resvg-js": "^2.6.2",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.0",
    "solid-js": "^1.9.4",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.3"
  }
}
