{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "sourceMap": true,
        "jsx": "preserve",
        "noEmit": false,
        "noCheck": true,
        "allowImportingTsExtensions": false,
        "rootDir": "src",
        "outDir": "dist"
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": [
        "test"
    ]
}