{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "emitDeclarationOnly": true,
        "declaration": true,
        "declarationMap": false,
        "sourceMap": false,
        "rootDir": "src",
        "outDir": "dist/types",
        "composite": false,
        "incremental": false
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": [
        "test",
        "dist"
    ]
}